# GitRepos environment variables. Copy to .env.local for local runs (never commit .env.local).
# In GitHub Actions these come from repo Secrets / Variables (see README "GitHub Actions setup").

# --- Data pipeline -----------------------------------------------------------
# GitHub token for GraphQL / Search / README reads (public data only).
# In Actions this is set from the GH_PAT secret (names can't start with GITHUB_), falling back to the
# built-in Actions token. Locally: a fine-grained PAT with "Public repositories (read-only)".
GITHUB_TOKEN=
# Gemini API key (Google AI Studio, free tier). Optional: summaries fall back to templates.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Cloudflare (Workers + D1, Workers Free plan, no card needed) -------------
CLOUDFLARE_ACCOUNT_ID=
# API token with: Account > Workers Scripts: Edit, Account > D1: Edit (see README).
CLOUDFLARE_API_TOKEN=
# Printed by `npx wrangler d1 create gitrepos`. Leave empty to run jobs against the local D1.
D1_DATABASE_ID=

# --- Data branch (raw hourly sample counts, daily totals, metadata + star history) ---
DATA_BRANCH=data
DATA_DIR=.data/branch
# Only CI pushes the data branch. Keep 0 locally.
DATA_PUSH=0

# --- Free-tier guards / tuning ------------------------------------------------
D1_DAILY_WRITE_BUDGET=80000   # D1 Free = 100,000 rows written/day; jobs throttle above this
TRACKED_LIMIT=5000            # repos measured every 6h
MIN_DAILY_STARS=3             # daily files keep repos with >= this many stars gained that day
MAX_PREBUILT_REPOS=5000       # repo pages prerendered per deploy (Workers Free: 20,000 asset files)
SUMMARY_LIMIT=40              # AI summaries per day (Gemini free tier)
SPAM_CHECK_LIMIT=300
README_LIMIT=300
INGEST_MAX_HOURS=6
FALLBACK_AFTER_HOURS=3

# --- Site ----------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Prompt 2/3 (payments, admin, email, Instagram) — not used yet --------------
DODO_PAYMENTS_API_KEY=
DODO_WEBHOOK_SECRET=
DODO_ENV=test_mode
IG_USER_ID=
IG_ACCESS_TOKEN=
META_APP_ID=
META_APP_SECRET=
RESEND_API_KEY=
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
CRON_SECRET=
APPROVAL_REQUIRED=true
# Unused: summaries use Gemini instead of the Claude API (kept from spec §10.2 for completeness).
ANTHROPIC_API_KEY=

# --- AdSense (added at the very end; keep disabled) ------------------------------
ADSENSE_ENABLED=false
NEXT_PUBLIC_ADSENSE_CLIENT=

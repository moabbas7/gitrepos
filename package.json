{
  "name": "gitrepos",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "cf:build": "opennextjs-cloudflare build",
    "cf:check": "tsx scripts/check-assets.ts",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && tsx scripts/check-assets.ts && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:migrate": "wrangler d1 migrations apply gitrepos --local",
    "db:migrate:remote": "wrangler d1 migrations apply gitrepos --remote",
    "db:seed": "tsx scripts/seed.ts",
    "job:ingest": "tsx jobs/ingest-gharchive.ts",
    "job:rank": "tsx jobs/rank.ts",
    "job:metadata": "tsx jobs/refresh-metadata.ts",
    "job:snapshot": "tsx jobs/snapshot.ts",
    "job:prune": "tsx jobs/rollup-and-prune.ts",
    "job:summaries": "tsx jobs/summaries.ts",
    "build:snapshot": "tsx scripts/build-snapshot.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.18",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.78.0",
    "motion": "^14.14.0",
    "next": "16.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.11.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.1",
    "wrangler": "^4.167.0"
  },
  "engines": {
    "node": ">=22.13"
  }
}
